# (Optional) Redis connection for shared spin counter. Not required for deployment or local dev.
# REDIS_URL=redis://localhost:6379

# Azure Blob Storage for the karaoke song list (required). All song reads/writes
# go directly to blob storage so added songs survive restarts/redeploys.
AZURE_STORAGE_ACCOUNT_NAME=....
AZURE_STORAGE_ACCOUNT_KEY=.....
